# Node.js API Server Environment
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1

# Database (same as Laravel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab_management
DB_USER=root
DB_PASS=

# JWT Secret (change in production!)
JWT_SECRET=lab-management-secret-key-change-me-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:8000
